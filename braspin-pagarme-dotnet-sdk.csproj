<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <AssemblyName>braspin-pagarme-dotnet-sdk</AssemblyName>
    <PackageId>braspin-pagarme-dotnet-sdk</PackageId>
    <RootNamespace>PagarmeSDK</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageProjectUrl>https://github.com/braspin/braspin-pagarme-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/braspin/braspin-pagarme-dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>7.0.0</VersionPrefix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>braspin</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="examples\**\*.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

</Project>
